# ─── Supabase ────────────────────────────────────────────────────────────────
# Dev points at the LOCAL stack (`npm run db:start`), never at the hosted
# project: the e2e suite registers accounts on every run, and those would
# otherwise be real users in production, forever.
#
# The local keys are fixed, public, and identical on every machine — they are not
# secrets. Get them with `npx supabase status -o env`. The hosted project's keys
# are secrets; those live in CI variables and nowhere else.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Optional additional development hostnames, comma-separated (no scheme or path).
DEV_ALLOWED_ORIGINS=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<npx supabase status -o env | grep PUBLISHABLE_KEY>"

# Server-only. Bypasses RLS entirely — it must never reach the browser, which is
# exactly what the missing NEXT_PUBLIC_ prefix guarantees. Used for the two jobs
# RLS cannot do: resolving a username to an email at sign-in (you aren't signed
# in yet), and undoing a half-made account.
SUPABASE_SECRET_KEY="<npx supabase status -o env | grep SECRET_KEY>"
